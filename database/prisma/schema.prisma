generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id               String   @id @default(uuid()) @db.Uuid
  slug             String   @unique
  name             String
  tagline          String
  location         String
  logoUrl          String?  @map("logo_url")
  poweredBy        String   @map("powered_by")
  receiptPrefix    String   @map("receipt_prefix")
  defaultLanguage  String   @default("en") @map("default_language")
  attendanceMode   String   @default("daily") @map("attendance_mode")
  theme            Json
  typography       Json
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  users          User[]
  roles          Role[]
  academicYears  AcademicYear[]
  classes        Class[]
  sections       Section[]
  students       Student[]
  parents        Parent[]
  teachers       Teacher[]
  attendance     Attendance[]
  auditLogs      AuditLog[]
  parentStudents ParentStudent[]
  refreshTokens  RefreshToken[]

  @@map("schools")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  identifier   String
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userRoles     UserRole[]
  userScopes    UserScope[]
  student       Student?
  parent        Parent?
  teacher       Teacher?
  refreshTokens RefreshToken[]
  markedAttendance Attendance[] @relation("MarkedBy")
  auditLogs     AuditLog[]

  @@unique([schoolId, identifier])
  @@index([schoolId])
  @@map("users")
}

model Role {
  id        String  @id @default(uuid()) @db.Uuid
  schoolId  String  @map("school_id") @db.Uuid
  code      String
  name      String
  isSystem  Boolean @default(true) @map("is_system")

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([schoolId, code])
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique
  resource    String
  action      String
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserScope {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  scopeType String  @map("scope_type")
  classId   String? @map("class_id") @db.Uuid
  sectionId String? @map("section_id") @db.Uuid
  subjectId String? @map("subject_id") @db.Uuid
  studentId String? @map("student_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_scopes")
}

model AcademicYear {
  id        String  @id @default(uuid()) @db.Uuid
  schoolId  String  @map("school_id") @db.Uuid
  name      String
  isActive  Boolean @default(true) @map("is_active")

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes Class[]

  @@index([schoolId])
  @@map("academic_years")
}

model Class {
  id             String @id @default(uuid()) @db.Uuid
  schoolId       String @map("school_id") @db.Uuid
  academicYearId String @map("academic_year_id") @db.Uuid
  name           String

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  sections     Section[]
  students     Student[]

  @@index([schoolId])
  @@map("classes")
}

model Section {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  classId  String @map("class_id") @db.Uuid
  name     String

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  students    Student[]
  attendance  Attendance[]

  @@index([schoolId])
  @@map("sections")
}

model Student {
  id               String @id @default(uuid()) @db.Uuid
  schoolId         String @map("school_id") @db.Uuid
  userId           String @unique @map("user_id") @db.Uuid
  admissionNumber  String @map("admission_number")
  fullName         String @map("full_name")
  classId          String @map("class_id") @db.Uuid
  sectionId        String @map("section_id") @db.Uuid
  status           String @default("active")

  school   School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  class    Class           @relation(fields: [classId], references: [id])
  section  Section         @relation(fields: [sectionId], references: [id])
  parents  ParentStudent[]
  attendance Attendance[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId, sectionId])
  @@map("students")
}

model Parent {
  id        String  @id @default(uuid()) @db.Uuid
  schoolId  String  @map("school_id") @db.Uuid
  userId    String  @unique @map("user_id") @db.Uuid
  fullName  String  @map("full_name")
  contact   String?

  school   School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  children ParentStudent[]

  @@index([schoolId])
  @@map("parents")
}

model ParentStudent {
  schoolId  String @map("school_id") @db.Uuid
  parentId  String @map("parent_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
  @@index([schoolId])
  @@map("parent_students")
}

model Teacher {
  id         String @id @default(uuid()) @db.Uuid
  schoolId   String @map("school_id") @db.Uuid
  userId     String @unique @map("user_id") @db.Uuid
  employeeId String @map("employee_id")
  fullName   String @map("full_name")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, employeeId])
  @@map("teachers")
}

model Attendance {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  sectionId      String   @map("section_id") @db.Uuid
  date           DateTime @db.Date
  status         String
  markedByUserId String   @map("marked_by_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section  Section @relation(fields: [sectionId], references: [id])
  markedBy User    @relation("MarkedBy", fields: [markedByUserId], references: [id])

  @@unique([schoolId, studentId, date])
  @@index([schoolId, sectionId, date])
  @@map("attendance")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  schoolId   String   @map("school_id") @db.Uuid
  actorUserId String  @map("actor_user_id") @db.Uuid
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actor  User   @relation(fields: [actorUserId], references: [id])

  @@index([schoolId, createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("refresh_tokens")
}
