generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id              String   @id @default(uuid()) @db.Uuid
  slug            String   @unique
  name            String
  tagline         String
  location        String
  logoUrl         String?  @map("logo_url")
  poweredBy       String   @map("powered_by")
  receiptPrefix   String   @map("receipt_prefix")
  defaultLanguage String   @default("en") @map("default_language")
  attendanceMode  String   @default("daily") @map("attendance_mode")
  theme           Json
  typography      Json
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  users          User[]
  roles          Role[]
  userRoles      UserRole[]
  userScopes     UserScope[]
  rolePermissions RolePermission[]
  academicYears  AcademicYear[]
  classes        Class[]
  sections       Section[]
  students       Student[]
  parents        Parent[]
  teachers       Teacher[]
  attendance     Attendance[]
  auditLogs      AuditLog[]
  parentStudents ParentStudent[]
  refreshTokens  RefreshToken[]
  inbox          InboxNotification[]
  homeworks      Homework[]
  homeworkCompletions HomeworkCompletion[]
  subjects       Subject[]
  timetablePeriods TimetablePeriod[]
  exams            Exam[]
  marks            Mark[]

  @@map("schools")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  identifier   String
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  isActive     Boolean  @default(true) @map("is_active")
  pushToken    String?  @map("push_token")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  school           School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userRoles        UserRole[]
  userScopes       UserScope[]
  student          Student?
  parent           Parent?
  teacher          Teacher?
  refreshTokens    RefreshToken[]
  markedAttendance Attendance[]   @relation("MarkedBy")
  auditLogs        AuditLog[]
  inbox            InboxNotification[]
  homeworks        Homework[]

  @@unique([id, schoolId])
  @@unique([schoolId, identifier])
  @@index([schoolId])
  @@map("users")
}

model Role {
  id       String  @id @default(uuid()) @db.Uuid
  schoolId String  @map("school_id") @db.Uuid
  code     String
  name     String
  isSystem Boolean @default(true) @map("is_system")

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([id, schoolId])
  @@unique([schoolId, code])
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique
  resource    String
  action      String
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid
  schoolId     String @map("school_id") @db.Uuid

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId, schoolId], references: [id, schoolId], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([schoolId])
  @@map("role_permissions")
}

model UserRole {
  userId   String @map("user_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid
  schoolId String @map("school_id") @db.Uuid

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId, schoolId], references: [id, schoolId], onDelete: Cascade)
  role   Role   @relation(fields: [roleId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([schoolId])
  @@map("user_roles")
}

model UserScope {
  id        String  @id @default(uuid()) @db.Uuid
  schoolId  String  @map("school_id") @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  /// school | class | section | subject | self | children
  scopeType String  @map("scope_type")
  classId   String? @map("class_id") @db.Uuid
  sectionId String? @map("section_id") @db.Uuid
  subjectId String? @map("subject_id") @db.Uuid
  studentId String? @map("student_id") @db.Uuid

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId, schoolId], references: [id, schoolId], onDelete: Cascade)
  // class/section/student composite FKs + scope_type CHECKs are in SQL migrations.
  // Prisma cannot model optional composite FKs with a required schoolId.

  @@index([userId])
  @@index([schoolId])
  @@map("user_scopes")
}

model AcademicYear {
  id       String  @id @default(uuid()) @db.Uuid
  schoolId String  @map("school_id") @db.Uuid
  name     String
  isActive Boolean @default(true) @map("is_active")

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes Class[]

  @@unique([id, schoolId])
  @@index([schoolId])
  @@map("academic_years")
}

model Class {
  id             String @id @default(uuid()) @db.Uuid
  schoolId       String @map("school_id") @db.Uuid
  academicYearId String @map("academic_year_id") @db.Uuid
  name           String

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId], onDelete: Cascade)
  sections     Section[]
  students     Student[]
  homeworks    Homework[]
  timetablePeriods TimetablePeriod[]
  exams            Exam[]

  @@unique([id, schoolId])
  @@index([schoolId])
  @@map("classes")
}

model Section {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  classId  String @map("class_id") @db.Uuid
  name     String

  school     School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class      Class        @relation(fields: [classId, schoolId], references: [id, schoolId], onDelete: Cascade)
  students   Student[]
  attendance Attendance[]
  homeworks  Homework[]
  timetablePeriods TimetablePeriod[]
  exams            Exam[]

  @@unique([id, schoolId])
  @@index([schoolId])
  @@map("sections")
}

model Student {
  id              String @id @default(uuid()) @db.Uuid
  schoolId        String @map("school_id") @db.Uuid
  userId          String @unique @map("user_id") @db.Uuid
  admissionNumber String @map("admission_number")
  fullName        String @map("full_name")
  classId         String @map("class_id") @db.Uuid
  sectionId       String @map("section_id") @db.Uuid
  status          String @default("active")

  school     School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId, schoolId], references: [id, schoolId], onDelete: Cascade)
  class      Class           @relation(fields: [classId, schoolId], references: [id, schoolId])
  section    Section         @relation(fields: [sectionId, schoolId], references: [id, schoolId])
  parents    ParentStudent[]
  attendance Attendance[]
  homeworkCompletions HomeworkCompletion[]
  marks               Mark[]

  @@unique([id, schoolId])
  @@unique([userId, schoolId])
  @@unique([schoolId, admissionNumber])
  @@index([schoolId, sectionId])
  @@map("students")
}

model Parent {
  id       String  @id @default(uuid()) @db.Uuid
  schoolId String  @map("school_id") @db.Uuid
  userId   String  @unique @map("user_id") @db.Uuid
  fullName String  @map("full_name")
  contact  String?

  school   School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId, schoolId], references: [id, schoolId], onDelete: Cascade)
  children ParentStudent[]

  @@unique([id, schoolId])
  @@unique([userId, schoolId])
  @@index([schoolId])
  @@map("parents")
}

model ParentStudent {
  schoolId  String @map("school_id") @db.Uuid
  parentId  String @map("parent_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId, schoolId], references: [id, schoolId], onDelete: Cascade)
  student Student @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@id([parentId, studentId])
  @@index([schoolId])
  @@map("parent_students")
}

model Teacher {
  id         String @id @default(uuid()) @db.Uuid
  schoolId   String @map("school_id") @db.Uuid
  userId     String @unique @map("user_id") @db.Uuid
  employeeId String @map("employee_id")
  fullName   String @map("full_name")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId, schoolId], references: [id, schoolId], onDelete: Cascade)
  timetablePeriods TimetablePeriod[]

  @@unique([id, schoolId])
  @@unique([userId, schoolId])
  @@unique([schoolId, employeeId])
  @@map("teachers")
}

model Attendance {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  sectionId      String   @map("section_id") @db.Uuid
  date           DateTime @db.Date
  status         String
  markedByUserId String   @map("marked_by_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student  Student @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: Cascade)
  section  Section @relation(fields: [sectionId, schoolId], references: [id, schoolId])
  markedBy User    @relation("MarkedBy", fields: [markedByUserId, schoolId], references: [id, schoolId])

  @@unique([schoolId, studentId, date])
  @@index([schoolId, sectionId, date])
  @@map("attendance")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  action      String
  resource    String
  resourceId  String?  @map("resource_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actor  User   @relation(fields: [actorUserId, schoolId], references: [id, schoolId])

  @@index([schoolId, createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@index([tokenHash])
  @@map("refresh_tokens")
}

model InboxNotification {
  id        String    @id @default(uuid()) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  studentId String?   @map("student_id") @db.Uuid
  kind      String
  title     String
  body      String
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([id, schoolId])
  @@index([schoolId, userId, createdAt])
  @@map("notifications")
}

model Homework {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  classId        String   @map("class_id") @db.Uuid
  sectionId      String   @map("section_id") @db.Uuid
  title          String
  body           String
  dueDate        DateTime @map("due_date") @db.Date
  createdByUserId String  @map("created_by_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  school     School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class      Class                  @relation(fields: [classId, schoolId], references: [id, schoolId])
  section    Section                @relation(fields: [sectionId, schoolId], references: [id, schoolId])
  createdBy  User                   @relation(fields: [createdByUserId, schoolId], references: [id, schoolId])
  completions HomeworkCompletion[]

  @@unique([id, schoolId])
  @@index([schoolId, sectionId, dueDate])
  @@map("homeworks")
}

model HomeworkCompletion {
  schoolId    String   @map("school_id") @db.Uuid
  homeworkId  String   @map("homework_id") @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  completedAt DateTime @default(now()) @map("completed_at")

  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  homework Homework @relation(fields: [homeworkId, schoolId], references: [id, schoolId], onDelete: Cascade)
  student  Student  @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@id([homeworkId, studentId])
  @@index([schoolId])
  @@map("homework_completions")
}

model Subject {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  name     String

  school   School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  periods  TimetablePeriod[]
  exams    Exam[]

  @@unique([id, schoolId])
  @@unique([schoolId, name])
  @@map("subjects")
}

model TimetablePeriod {
  id        String  @id @default(uuid()) @db.Uuid
  schoolId  String  @map("school_id") @db.Uuid
  classId   String  @map("class_id") @db.Uuid
  sectionId String  @map("section_id") @db.Uuid
  subjectId String  @map("subject_id") @db.Uuid
  teacherId String  @map("teacher_id") @db.Uuid
  weekday   Int
  startTime String  @map("start_time")
  endTime   String  @map("end_time")
  published Boolean @default(false)

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId, schoolId], references: [id, schoolId])
  section Section @relation(fields: [sectionId, schoolId], references: [id, schoolId])
  subject Subject @relation(fields: [subjectId, schoolId], references: [id, schoolId])
  teacher Teacher @relation(fields: [teacherId, schoolId], references: [id, schoolId])

  @@unique([id, schoolId])
  @@unique([schoolId, sectionId, weekday, startTime])
  @@index([schoolId, sectionId, weekday])
  @@map("timetable_periods")
}

model Exam {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  sectionId String   @map("section_id") @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  name      String
  examDate  DateTime @map("exam_date") @db.Date
  maxScore  Int      @map("max_score")

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId, schoolId], references: [id, schoolId])
  section Section @relation(fields: [sectionId, schoolId], references: [id, schoolId])
  subject Subject @relation(fields: [subjectId, schoolId], references: [id, schoolId])
  marks   Mark[]

  @@unique([id, schoolId])
  @@index([schoolId, sectionId])
  @@map("exams")
}

model Mark {
  id        String @id @default(uuid()) @db.Uuid
  schoolId  String @map("school_id") @db.Uuid
  examId    String @map("exam_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid
  score     Int
  status    String
  updatedByUserId String @map("updated_by_user_id") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  exam    Exam    @relation(fields: [examId, schoolId], references: [id, schoolId], onDelete: Cascade)
  student Student @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([id, schoolId])
  @@unique([schoolId, examId, studentId])
  @@index([schoolId, examId, status])
  @@map("marks")
}
