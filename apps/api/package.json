    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.16.1",
    "@schoolos/permissions": "workspace:*",
    "@schoolos/types": "workspace:*",
    "@schoolos/validation": "workspace:*",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.58.5",
    "ioredis": "^5.8.0",
    "minio": "^8.0.5",
    "multer": "^2.0.2",
    "pdfkit": "0.17.2",
    "reflect-metadata": "^0.2.2",
