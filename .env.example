# Copy to .env for local development. Never commit real secrets.

NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://schoolos:schoolos@localhost:5433/schoolos?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# Access tokens are short-lived; clients auto-refresh using the refresh token + tenant slug.
JWT_ACCESS_TTL=15m
# Refresh tokens rotate on each /auth/refresh call and are revoked on logout.
JWT_REFRESH_TTL=7d

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=schoolos
MINIO_SECRET_KEY=schoolos-minio
MINIO_BUCKET=schoolos

# Demo seed only — sources do not specify a password. See README.
SEED_PASSWORD=Password123!

# Mobile default tenant slug (name/logo still come from branding API)
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_DEFAULT_SLUG=arulneri
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_SLUG=arulneri
