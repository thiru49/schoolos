{
  "name": "schoolos",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @schoolos/api test:integration",
    "test:security": "pnpm tsx tests/security/attendance-isolation.ts; pnpm tsx tests/security/people-isolation.ts; pnpm tsx tests/security/homework-isolation.ts; pnpm tsx tests/security/timetable-isolation.ts; pnpm tsx tests/security/exams-isolation.ts; pnpm tsx tests/security/tenant-db-integrity.ts",
    "db:generate": "prisma generate --schema database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema database/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema database/prisma/schema.prisma",
    "db:seed": "tsx database/prisma/seed/index.ts",
    "db:studio": "prisma studio --schema database/prisma/schema.prisma"
  },
  "devDependencies": {
    "prisma": "^6.16.1",
    "tsx": "^4.20.5",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "@types/bcryptjs": "^2.4.6"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "@schoolos/permissions": "workspace:*",
    "@schoolos/types": "workspace:*",
    "bcryptjs": "^3.0.2"
  },
  "prisma": {
    "schema": "database/prisma/schema.prisma",
    "seed": "tsx database/prisma/seed/index.ts"
  },
  "engines": {
    "node": ">=20"
  }
}
